import java.util.Scanner;
import java.util.ArrayList;
import java.util.List;

class CalculatorApp {
    private static double result = 0;
    private static final List<Double> history = new ArrayList<>(); // Stores past results
    private static final Scanner scanner = new Scanner(System.in);

    public static void main(String[] args) {
        System.out.println("Welcome to the Calculator!");

        while (true) {
            System.out.println("\nCurrent result: " + result);
            System.out.println("Enter '+ number' to add, 'history' to view past results, or 'exit' to quit:");

            String input = scanner.nextLine().trim();

            if (input.equalsIgnoreCase("exit")) {
                break;
            } else if (input.equalsIgnoreCase("history")) {
                showHistory();
                continue;
            }

            result = performAddition(input);
        }

        scanner.close();
    }

    private static double performAddition(String input) {
        String[] parts = input.split(" ");
        if (parts.length != 2 || !parts[0].equals("+")) {
            System.out.println("Invalid input. Please enter in the format: '+ number' (e.g., + 5).");
            return result;
        }

        try {
            double number = Double.parseDouble(parts[1]);
            history.add(result); // Store previous result before adding
            result += number;
            history.add(result); // Store new result after addition
            return result;
        } catch (NumberFormatException e) {
            System.out.println("Invalid number. Please enter a valid numeric value.");
            return result;
        }
    }

    private static void showHistory() {
        if (history.isEmpty()) {
            System.out.println("No history available.");
        } else {
            System.out.println("Calculation History:");
            for (double pastResult : history) {
                System.out.println(pastResult);
            }
        }
    }
}
